{
  "name": "manifest-chronicles-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Catacombs of Despair II: The Manifest Chronicles, ported from QuickBASIC to the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
